---
import FeaturedBlogs from "../components/FeaturedBlogs.astro";
import FeaturedProjects from "../components/FeaturedProjects.astro";
import Footer from "../components/Footer.astro";
import Gap from "../components/Gap.astro";
import Hero from "../components/Hero.astro";
import TechMarquee from "../components/TechMarquee.astro";
import Testimonials from "../components/Testimonials.astro";
import { SITE_DESCRIPTION, SITE_IDENTITY } from "../data/site";
import { testimonials } from "../data/testimonials";
import BaseLayout from "../layouts/BaseLayout.astro";

const showTestimonials = testimonials.length >= 6;
const jsonLd = Astro.site
  ? {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": new URL("/#website", Astro.site).toString(),
      name: SITE_IDENTITY.name,
      description: SITE_DESCRIPTION,
      url: Astro.site.toString(),
      author: { "@id": new URL("/profile/#person", Astro.site).toString() },
      publisher: { "@id": new URL("/profile/#person", Astro.site).toString() },
      about: { "@id": new URL("/profile/#person", Astro.site).toString() },
    }
  : undefined;
---

<BaseLayout jsonLd={jsonLd}>
  <main>
    <Hero />
    <Gap size="small" variant="blank" corner="top-left" />
    <TechMarquee />
    <Gap size="small" variant="filled" corner="bottom-right" />
    <FeaturedBlogs />
    {showTestimonials && <Gap size="small" variant="blank" />}
    {showTestimonials && <Testimonials />}
    <Gap size="small" variant="filled" corner="bottom-left" />
    <FeaturedProjects />
    <Gap size="medium" variant="filled" corner="bottom-right" />
  </main>
  <Footer />
</BaseLayout>
