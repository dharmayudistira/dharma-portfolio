---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found"
  description="This page could not be found. Explore Dharma Yudistira’s projects, writing, or home page."
  noindex
>
  <main class="not-found">
    <p class="not-found__code">404</p>
    <h1>Page not found.</h1>
    <p>The link may be outdated, or the address may contain a typo.</p>
    <nav class="not-found__links" aria-label="Find another page">
      <a href="/">Back to home</a>
      <a href="/projects/">Explore projects</a>
      <a href="/blog/">Read the blog</a>
    </nav>
  </main>
</BaseLayout>

<style>
  .not-found {
    width: min(var(--content-max-width), calc(100% - var(--page-gutter) - var(--page-gutter)));
    min-height: 100svh;
    margin-inline: auto;
    padding: calc(var(--header-height) + 64px) 24px 64px;
  }

  .not-found__code {
    margin: 0 0 16px;
    color: var(--muted);
    font: 500 1rem/1.5 var(--font-mono);
  }

  .not-found h1 {
    margin: 0 0 24px;
    font: 500 clamp(2rem, 7vw, 4rem)/1.1 var(--font-sans);
    letter-spacing: -0.04em;
  }

  .not-found > p:not(.not-found__code) {
    max-width: 48ch;
    color: var(--muted);
    line-height: 1.6;
  }

  .not-found__links {
    margin-block-start: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
  }

  .not-found__links a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .not-found__links a:focus-visible {
    outline: 2px solid var(--foreground);
    outline-offset: 4px;
  }
</style>
