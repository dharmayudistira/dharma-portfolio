---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { Monitor, Smartphone } from "lucide";
import MorphIcon from "morphicons/astro";
import DetailHeader from "../../components/DetailHeader.astro";
import Footer from "../../components/Footer.astro";
import Gap from "../../components/Gap.astro";
import { STACK_LABELS } from "../../data/stacks";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await render(project);
const platforms = project.data.platform.split("·").map((value) => {
  const label = value.trim();
  const icon = /^(web|website)$/i.test(label)
    ? Monitor
    : /^mobile$/i.test(label) ? Smartphone : undefined;

  return { label, icon };
});
const canonical = Astro.site
  ? new URL(`/projects/${project.id}/`, Astro.site).toString()
  : undefined;
const image = project.data.cover;
const jsonLd = canonical
  ? {
      "@context": "https://schema.org",
      "@type": "CreativeWork",
      name: project.data.title,
      description: project.data.summary,
      datePublished: project.data.publishedAt.toISOString(),
      dateModified: project.data.updatedAt?.toISOString(),
      url: canonical,
      image: image && Astro.site ? new URL(image.src, Astro.site).toString() : undefined,
      author: {
        "@id": new URL("/profile/#person", Astro.site).toString(),
      },
      keywords: project.data.stack.map((id) => STACK_LABELS[id]).join(", "),
    }
  : undefined;
---

<BaseLayout
  title={project.data.title}
  description={project.data.summary}
  image={image}
  canonicalUrl={canonical}
  jsonLd={jsonLd}
>
  <main class="project-page">
    <DetailHeader title={project.data.title} description={project.data.summary} word="project">
      <div>
        <dt class="visually-hidden">Role</dt>
        <dd class="project-page__detail project-page__detail--role">
          <span class="project-page__role-prefix">as</span>
          <span>{project.data.role}</span>
        </dd>
      </div>
      <div>
        <dt class="visually-hidden">Platform</dt>
        <dd class="project-page__platforms">
          {platforms.map(({ label, icon }) => (
            <span class="project-page__detail" title={label}>
              {icon
                ? <MorphIcon icon={icon} size={16} strokeWidth={1.5} label={label} />
                : <span>{label}</span>}
            </span>
          ))}
        </dd>
      </div>
    </DetailHeader>
    <div class="project-page__frame project-page__content">
      <article class="prose">
        <Content />
      </article>
    </div>
  </main>
  <Gap size="medium" variant="filled" />
  <Footer />
</BaseLayout>

<style>
  .project-page {
    --project-frame-width: min(
      var(--content-max-width),
      calc(100% - var(--page-gutter) - var(--page-gutter))
    );
    min-height: 100svh;
    padding-block-start: var(--header-height);
  }

  .project-page__frame {
    width: var(--project-frame-width);
    margin-inline: auto;
    padding-inline: 40px;
  }

  .project-page__detail {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .project-page__detail :global(svg) {
    flex-shrink: 0;
  }

  .project-page__detail--role {
    align-items: baseline;
  }

  .project-page__role-prefix {
    flex-shrink: 0;
    color: var(--muted);
    font: 500 16px/1 var(--font-hand);
  }

  .project-page__platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
  }

  .project-page__content {
    padding-block-end: 120px;
  }

  .project-page__content .prose {
    max-width: none;
  }

  @media (max-width: 767px) {
    .project-page__frame {
      padding-inline: 20px;
    }
  }
</style>
