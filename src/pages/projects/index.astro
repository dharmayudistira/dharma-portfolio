---
import ContentLayout from "../../layouts/ContentLayout.astro";
import Gap from "../../components/Gap.astro";
import Footer from "../../components/Footer.astro";
import IndexHero from "../../components/IndexHero.astro";
import IndexSearchToolbar from "../../components/IndexSearchToolbar.astro";
import ProjectGrid from "../../components/ProjectGrid.astro";
import ProjectDevices from "../../components/ProjectDevices.astro";
---

<ContentLayout
  title="projects."
  description="Selected product engineering work across frontend and mobile experiences."
  showDescription={false}
  pageClass="projects-page index-hero"
>
  <IndexHero word="project" />
  <ProjectDevices />
  <Fragment slot="after-content">
    <Gap size="small" variant="filled" />
    <IndexSearchToolbar collection="projects" />
    <Gap size="extra-small" variant="blank" corner="bottom-right" />
    <ProjectGrid />
    <Gap size="medium" variant="filled" />
  </Fragment>
  <Footer slot="after-main" />
</ContentLayout>

<style>
  :global(.projects-page .content-page__header) {
    width: fit-content;
  }

  :global(.project-grid:has(+ .gap)) {
    z-index: 1;
  }

  :global(.index-search + .gap),
  :global(.project-grid + .gap) {
    border-block-start: 0;
  }

  :global(.project-grid + .gap .gap__cross--top-left),
  :global(.project-grid + .gap .gap__cross--top-right) {
    display: none;
  }
</style>
