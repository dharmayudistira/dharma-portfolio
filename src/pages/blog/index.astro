---
import ContentLayout from "../../layouts/ContentLayout.astro";
import Gap from "../../components/Gap.astro";
import Footer from "../../components/Footer.astro";
import IndexHero from "../../components/IndexHero.astro";
import IndexSearchToolbar from "../../components/IndexSearchToolbar.astro";
import BlogList from "../../components/BlogList.astro";
---

<ContentLayout
  title="blogs."
  description="Notes on product engineering, interfaces, animation, and building software."
  showDescription={false}
  pageClass="blogs-page index-hero"
>
  <IndexHero word="blogs" />
  <Fragment slot="after-content">
    <Gap size="small" variant="filled" />
    <IndexSearchToolbar collection="blog" />
    <Gap size="extra-small" variant="blank" corner="bottom-right" />
    <BlogList />
    <Gap size="medium" variant="filled" />
  </Fragment>
  <Footer slot="after-main" />
</ContentLayout>

<style>
  :global(.blog-list:has(+ .gap)) {
    z-index: 1;
  }

  :global(.gap:has(+ .blog-list)) {
    border-block-end: 0;
  }

  :global(.gap:has(+ .blog-list) :is(.gap__cross--bottom-left, .gap__cross--bottom-right)) {
    display: none;
  }

  :global(.blog-list + .gap),
  :global(main:has(.blog-list) + .site-footer) {
    border-block-start: 0;
  }

  :global(.blog-list + .gap :is(.gap__cross--top-left, .gap__cross--top-right)) {
    display: none;
  }
</style>
