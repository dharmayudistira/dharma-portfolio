---
import { STACK_LABELS, type StackId } from "../data/stacks";

const stack = [
  "vs-code",
  "cursor",
  "react",
  "nextjs",
  "typescript",
  "nodejs",
  "postgresql",
  "dart",
  "kotlin",
] satisfies readonly StackId[];
---

<section class="stack" aria-labelledby="stack-title">
  <h2 class="visually-hidden" id="stack-title">Technology stack</h2>

  <div class="stack__frame">
    <span class="stack__cross stack__cross--top-left" aria-hidden="true"></span>
    <span class="stack__cross stack__cross--top-right" aria-hidden="true"></span>

    <div class="stack__marquee">
      <div class="stack__track">
        <ul class="stack__group">
          {stack.map((id) => <li>{STACK_LABELS[id]}</li>)}
        </ul>
        <ul class="stack__group" aria-hidden="true">
          {stack.map((id) => <li>{STACK_LABELS[id]}</li>)}
        </ul>
      </div>
    </div>

    <span class="stack__cross stack__cross--bottom-left" aria-hidden="true"></span>
    <span class="stack__cross stack__cross--bottom-right" aria-hidden="true"></span>
  </div>
</section>
