---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { STACK_LABELS } from "../data/stacks";
import { getProjectSearchFields } from "../data/projects";
import UnderlineMark from "./UnderlineMark.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
---

<section class="project-grid" aria-label="Projects" data-project-grid>
  <ul class="project-grid__list" data-project-list hidden={projects.length === 0}>
    {projects.map((project) => (
      <li
        class="project-grid__item"
        data-project-item
        data-search-title={project.data.title}
        data-search-metadata={getProjectSearchFields(project).metadata}
        data-search-description={project.data.summary}
      >
        <article class="project-grid__project">
          <a
            class="project-grid__card"
            href={`/projects/${project.id}/`}
            aria-labelledby={`project-title-${project.id}`}
          >
            {project.data.cover ? (
              <span class="project-grid__cover project-grid__cover--image">
                <Image
                  src={project.data.cover}
                  alt={`Preview of ${project.data.title}`}
                  width={Math.min(project.data.cover.width, 704)}
                  widths={[320, 480, 640, 960, 1280]}
                  sizes="auto, (min-width: 769px) 50vw, 100vw"
                  loading="lazy"
                  decoding="async"
                />
              </span>
            ) : (
              <span
                class="project-grid__cover"
                aria-hidden="true"
              />
            )}
            <span class="project-grid__title">
              <h2 id={`project-title-${project.id}`}>{project.data.title}</h2>
              <UnderlineMark class="project-grid__title-mark" />
            </span>
            <p class="project-grid__summary">{project.data.summary}</p>
            {project.data.stack.length > 0 && (
              <ul class="project-grid__stack" aria-label="Stack">
                {project.data.stack.map((id) => (
                  <li>{STACK_LABELS[id]}</li>
                ))}
              </ul>
            )}
          </a>
        </article>
        <span class="project-grid__row-guide" aria-hidden="true">
          <span class="project-grid__guide-frame">
            <span class="gap__cross gap__cross--top-left" />
            <span class="gap__cross project-grid__cross--center" />
            <span class="gap__cross gap__cross--top-right" />
          </span>
        </span>
      </li>
    ))}
  </ul>
  <div class="project-grid__empty" data-project-empty hidden={projects.length > 0}>
    <h2>No projects found</h2>
    <p>Try fewer keywords or clear your search.</p>
    <span class="project-grid__row-guide" aria-hidden="true">
      <span class="project-grid__guide-frame">
        <span class="gap__cross gap__cross--top-left" />
        <span class="gap__cross gap__cross--top-right" />
      </span>
    </span>
  </div>
</section>

<style>
  .project-grid {
    --project-grid-card-padding: 32px;
    position: relative;
    container-type: inline-size;
    isolation: isolate;
  }

  .project-grid__list,
  .project-grid__empty {
    position: relative;
    width: min(var(--content-max-width), calc(100% - var(--page-gutter) - var(--page-gutter)));
    margin: 0 auto;
    border-inline: 1px dashed var(--technical-line-soft);
  }

  .project-grid__list {
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    list-style: none;
  }

  .project-grid__item {
    position: relative;
    min-width: 0;
  }

  .project-grid__row-guide {
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: calc((100% - 100cqw) / 2);
    width: 100cqw;
    border-block-end: 1px dashed var(--technical-line-soft);
    pointer-events: none;
  }

  .project-grid__guide-frame {
    position: relative;
    width: min(var(--content-max-width), calc(100% - var(--page-gutter) - var(--page-gutter)));
    margin-inline: auto;
    display: block;
  }

  .project-grid__cross--center {
    display: none;
    inset-block-start: 0;
    inset-inline-start: 50%;
  }

  .project-grid__project {
    height: 100%;
  }

  .project-grid__card {
    height: 100%;
    padding: 32px var(--project-grid-card-padding);
    display: flex;
    flex-direction: column;
  }

  .project-grid__card:focus-visible {
    outline: 2px solid var(--muted);
    outline-offset: -8px;
  }

  .project-grid__cover {
    position: relative;
    margin-block-end: 24px;
    display: block;
    flex-shrink: 0;
    aspect-ratio: 1.618;
    overflow: hidden;
    border: 1px dashed var(--technical-line-strong);
    border-radius: 12px;
  }

  .project-grid__cover img {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    display: block;
    width: 100%;
    height: 96%;
    border-radius: inherit;
    object-fit: cover;
    transform: translate(-50%, -50%);
  }

  .project-grid__cover--image {
    border: 1px solid transparent;
  }

  .project-grid__card h2,
  .project-grid__empty h2 {
    margin: 0;
    color: var(--foreground);
    font: 500 clamp(1.25rem, 2vw, 1.5rem)/1.25 var(--font-sans);
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .project-grid__summary,
  .project-grid__empty p {
    margin: 12px 0 0;
    color: var(--muted);
    font: 400 0.9375rem/1.6 var(--font-sans);
    overflow-wrap: anywhere;
  }

  .project-grid__stack {
    margin: auto 0 0;
    padding: 24px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
  }

  .project-grid__stack li {
    max-width: 100%;
    padding: 2px 8px;
    border: 1px solid var(--technical-line-soft);
    border-radius: 999px;
    background: var(--surface-raised);
    color: var(--foreground);
    font: 400 12px/18px var(--font-mono);
    white-space: nowrap;
  }

  .project-grid__card:is(:hover, :focus-visible) .project-grid__cover:not(.project-grid__cover--image) {
    border-color: var(--muted);
  }

  .project-grid__empty {
    padding: 32px var(--project-grid-card-padding);
  }

  @media (min-width: 769px) {
    .project-grid__list {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .project-grid__list::before {
      content: "";
      position: absolute;
      inset-block: 0;
      inset-inline-start: 50%;
      border-inline-start: 1px dashed var(--technical-line-soft);
      pointer-events: none;
    }

    .project-grid__item .project-grid__row-guide {
      inset-inline-start: calc(100% - 50cqw);
    }

    .project-grid__item:nth-child(even of :not([hidden])) .project-grid__row-guide {
      display: none;
    }

    .project-grid__cross--center {
      display: block;
    }
  }

  @media (max-width: 575px) {
    .project-grid {
      --project-grid-card-padding: 16px;
    }

    .project-grid__card,
    .project-grid__empty {
      padding: 24px var(--project-grid-card-padding);
    }
  }
</style>
