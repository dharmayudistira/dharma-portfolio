---
import { execFileSync } from "node:child_process";
import packageJson from "../../package.json";
import Gap from "./Gap.astro";
import FooterLandscape from "./FooterLandscape.astro";
import SocialLinks from "./SocialLinks.astro";
import UnderlineMark from "./UnderlineMark.astro";
import { SITE_IDENTITY } from "../data/site";
import { GOATCOUNTER_URL } from "../data/analytics";

const deploymentCommit =
  process.env.VERCEL_GIT_COMMIT_SHA ??
  process.env.CF_PAGES_COMMIT_SHA ??
  process.env.GITHUB_SHA;

const getBuildCommit = () => {
  if (deploymentCommit) {
    return deploymentCommit.slice(0, 7);
  }

  try {
    return execFileSync("git", ["rev-parse", "--short", "HEAD"], {
      encoding: "utf8",
    }).trim();
  } catch {
    return "unavailable";
  }
};

const buildCommit = getBuildCommit();
const updatedAt = new Date().toISOString().slice(0, 10);
const version = (value: string) => value.replace(/^\D+/, "");
const stack = [
  `astro@${version(packageJson.dependencies.astro)}`,
  `typescript@${version(packageJson.devDependencies.typescript)}`,
  `gsap@${version(packageJson.dependencies.gsap)}`,
  `uisfx@${version(packageJson.dependencies.uisfx)}`,
  "css",
];
const inspirations = [
  { name: "Chánh Đại", url: "https://chanhdai.com/" },
  { name: "Theodorus Clarence", url: "https://theodorusclarence.com/" },
  { name: "Lucas Marques", url: "https://www.lucasmarkes.com/" },
];
const repositoryUrl = SITE_IDENTITY.links.repository;
const siteLabel = Astro.site?.hostname ?? SITE_IDENTITY.name;
---

<footer class="site-footer">
  <div class="site-footer__frame">
    <header class="site-footer__intro">
      <strong>{siteLabel}</strong>
      <p>Curious by nature, product-minded by practice.</p>
    </header>

    <dl class="site-footer__details">
      <div class="site-footer__detail site-footer__detail--crafted">
        <dt>Crafted by</dt>
        <dd>
          <a class="site-footer__link" href={SITE_IDENTITY.links.x} rel="me noreferrer">
            <span class="site-footer__link-label">
              <span>{SITE_IDENTITY.shortName}</span>
              <UnderlineMark class="site-footer__link-mark" />
            </span>
          </a>
        </dd>
      </div>

      <div class="site-footer__detail site-footer__detail--build">
        <dt>Build</dt>
        <dd><code>{buildCommit}</code></dd>
      </div>

      <div class="site-footer__detail site-footer__detail--updated">
        <dt>Updated</dt>
        <dd><time datetime={updatedAt}>{updatedAt}</time></dd>
      </div>

      <div class="site-footer__detail site-footer__detail--analytics">
        <dt>Analytics</dt>
        <dd>
          <a class="site-footer__link" href={GOATCOUNTER_URL ?? "https://www.goatcounter.com/"} rel="noreferrer">
            <span class="site-footer__link-label">
              <span>GoatCounter</span>
              <UnderlineMark class="site-footer__link-mark" />
            </span>
          </a>
        </dd>
      </div>

      <div class="site-footer__detail site-footer__detail--deployed">
        <dt>Deployed on</dt>
        <dd>Vercel</dd>
      </div>

      <div class="site-footer__detail site-footer__detail--source">
        <dt>Source code</dt>
        <dd>
          <a class="site-footer__link" href={repositoryUrl} rel="noreferrer">
            <span class="site-footer__link-label">
              <span>GitHub</span>
              <UnderlineMark class="site-footer__link-mark" />
            </span>
          </a>
        </dd>
      </div>

      <div class="site-footer__detail site-footer__detail--license">
        <dt>License</dt>
        <dd>
          <a class="site-footer__link" href={`${repositoryUrl}/blob/main/LICENSE`} rel="noreferrer">
            <span class="site-footer__link-label">
              <span>MIT License</span>
              <UnderlineMark class="site-footer__link-mark" />
            </span>
          </a>
        </dd>
      </div>

      <div class="site-footer__detail site-footer__detail--typeface">
        <dt>Typeface</dt>
        <dd>Geist</dd>
      </div>

      <div class="site-footer__detail site-footer__detail--stack">
        <dt>Stack</dt>
        <dd class="site-footer__stack">
          {stack.map((item) => <span>{item}</span>)}
        </dd>
      </div>

      <div class="site-footer__detail site-footer__detail--agents">
        <dt>For agents</dt>
        <dd class="site-footer__agents">
          <a class="site-footer__link" href="/llms.txt">
            <span class="site-footer__link-label">
              <span>llms.txt</span>
              <UnderlineMark class="site-footer__link-mark" />
            </span>
          </a>
          <a class="site-footer__link" href="/index.md">
            <span class="site-footer__link-label">
              <span>index.md</span>
              <UnderlineMark class="site-footer__link-mark" />
            </span>
          </a>
          <a class="site-footer__link" href="/rss.xml">
            <span class="site-footer__link-label">
              <span>rss.xml</span>
              <UnderlineMark class="site-footer__link-mark" />
            </span>
          </a>
          <a class="site-footer__link" href="/statistics/">
            <span class="site-footer__link-label">
              <span>statistics</span>
              <UnderlineMark class="site-footer__link-mark" />
            </span>
          </a>
        </dd>
      </div>

      <div class="site-footer__detail site-footer__detail--inspired">
        <dt>Inspired by</dt>
        <dd>
          <ol class="site-footer__inspirations">
            {
              inspirations.map((item, index) => (
                <li>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <a class="site-footer__link" href={item.url} rel="noreferrer">
                    <span class="site-footer__link-label">
                      <span>{item.name}</span>
                      <UnderlineMark class="site-footer__link-mark" />
                    </span>
                  </a>
                </li>
              ))
            }
          </ol>
        </dd>
      </div>
    </dl>
  </div>

  <Gap size="extra-small" variant="blank" />

  <SocialLinks />

  <FooterLandscape />

  <Gap size="small" variant="blank" />
</footer>
