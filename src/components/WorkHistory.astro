---
import { ChevronDown, ChevronUp } from "lucide";
import MorphIcon from "morphicons/astro";
import { STACK_LABELS } from "../data/stacks";
import { workHistory } from "../data/work-history";

const dateFormat = new Intl.DateTimeFormat("en", { month: "short", year: "numeric", timeZone: "UTC" });
const formatDate = (date: string) => dateFormat.format(new Date(`${date}-01T00:00:00Z`));
---

<section class="work-history" aria-labelledby="work-history-heading">
  <header class="work-history__heading">
    <div class="work-history__frame work-history__heading-inner">
      <h2 id="work-history-heading">Work History</h2>
      <span class="gap__cross gap__cross--bottom-left" aria-hidden="true" />
      <span class="gap__cross gap__cross--bottom-right" aria-hidden="true" />
    </div>
  </header>
  <div class="work-history__frame">
    <ol class="work-history__list" role="list">
      {workHistory.map((entry, index) => (
        <li class="work-history__entry">
          <div class="work-history__mark">
            <a class:list={["work-history__logo", { "work-history__logo--circle": entry.logoShape === "circle", "work-history__logo--on-light": entry.logoOnLight }]} href={entry.companyUrl} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${entry.company} website`}>
              {entry.logo && <img src={entry.logo} alt="" width="36" height="36" loading="lazy" decoding="async" />}
            </a>
          </div>
          <div class="work-history__content">
            <h3 class="work-history__intro" aria-label={entry.company}>
              <button class="work-history__toggle" type="button" aria-expanded={index === 0} aria-controls={`work-history-description-${index}`} data-work-history-toggle>
                <span class="work-history__identity">
                  <span class="work-history__company">{entry.company}</span>
                  <span class="work-history__role">
                    <span class="work-history__as">as</span> {entry.role}
                    <span class="work-history__employment">{entry.employmentType}</span>
                  </span>
                </span>
                <span class="work-history__meta">
                  <span class="work-history__dates">
                    <time datetime={entry.start}>{formatDate(entry.start)}</time>
                    {" – "}
                    {entry.end
                      ? <time datetime={entry.end}>{formatDate(entry.end)}</time>
                      : "Present"}
                  </span>
                  <span class="work-history__chevron" aria-hidden="true">
                    <MorphIcon icon={index === 0 ? ChevronUp : ChevronDown} size={16} strokeWidth={1.5} data-work-history-icon />
                  </span>
                </span>
              </button>
            </h3>
            <ul id={`work-history-description-${index}`} class="work-history__bullets" hidden={index !== 0}>
              {entry.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
            <ul class="work-history__stack" aria-label={`${entry.company} stack`} role="list">
              {entry.stack.map((id) => <li>{STACK_LABELS[id]}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ol>
    <span class="gap__cross gap__cross--bottom-left" aria-hidden="true" />
    <span class="gap__cross gap__cross--bottom-right" aria-hidden="true" />
  </div>
</section>

<script>
  import { ChevronDown, ChevronUp } from "lucide";
  import type { MorphIconElement } from "morphicons/element";

  document.querySelectorAll<HTMLButtonElement>("[data-work-history-toggle]").forEach((button) => {
    const description = document.getElementById(button.getAttribute("aria-controls") ?? "");
    const icon = button.querySelector<MorphIconElement>("[data-work-history-icon]");
    if (!description || !icon) return;

    button.addEventListener("click", async () => {
      const expanded = button.getAttribute("aria-expanded") === "true";
      button.setAttribute("aria-expanded", String(!expanded));
      description.hidden = expanded;
      await customElements.whenDefined("morph-icon");
      icon.morphTo(expanded ? ChevronDown : ChevronUp, "bouncy");
    });
  });
</script>

<style>
  .work-history {
    border-block-end: 1px dashed var(--technical-line-soft);
  }

  .work-history__heading {
    border-block-end: 1px dashed var(--technical-line-soft);
  }

  .work-history__frame {
    position: relative;
    width: min(var(--content-max-width), calc(100% - var(--page-gutter) - var(--page-gutter)));
    margin-inline: auto;
  }

  .work-history__heading-inner {
    display: flex;
    align-items: center;
    min-height: 64px;
    padding: 10px clamp(20px, 5vw, 64px);
  }

  .work-history h2 {
    margin: 0;
    font: 500 24px/1.2 var(--font-sans);
    letter-spacing: -0.035em;
  }

  .work-history__list {
    margin: 0;
    padding: 0 clamp(20px, 5vw, 64px);
    list-style: none;
  }

  .work-history__entry {
    --work-history-mark-size: 36px;
    --work-history-mark-gap: 20px;
    display: grid;
    grid-template-columns: var(--work-history-mark-size) minmax(0, 1fr);
    column-gap: var(--work-history-mark-gap);
    padding-block: 28px;
  }

  .work-history__mark {
    position: relative;
  }

  .work-history__mark::before {
    position: absolute;
    inset-block: var(--work-history-mark-size) 12px;
    inset-inline-start: 50%;
    width: calc(50% + var(--work-history-mark-gap));
    border-inline-start: 1px solid var(--technical-line-strong);
    border-block-end: 1px solid var(--technical-line-strong);
    border-end-start-radius: 12px;
    content: "";
  }

  .work-history__logo {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--work-history-mark-size);
    height: var(--work-history-mark-size);
    padding: 1px;
    border: 1px solid var(--technical-line-strong);
    border-radius: 5px;
    background: var(--surface);
    overflow: hidden;
  }

  .work-history__logo--on-light {
    background: #fff;
  }

  .work-history__logo--circle {
    border-radius: 50%;
  }

  .work-history__logo:focus-visible {
    outline: 1px solid var(--foreground);
    outline-offset: 4px;
  }

  .work-history__logo:hover {
    border-color: var(--foreground);
  }

  .work-history__logo img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    object-fit: contain;
  }

  .work-history__content {
    min-width: 0;
  }

  .work-history__intro {
    margin: 0;
  }

  .work-history__toggle {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--foreground);
    text-align: start;
    cursor: pointer;
  }

  .work-history__toggle:focus-visible {
    outline: 1px solid var(--foreground);
    outline-offset: 4px;
  }

  .work-history__identity {
    min-width: 0;
  }

  .work-history__company {
    display: block;
    font: 600 16px/24px var(--font-sans);
    letter-spacing: -0.02em;
  }

  .work-history__role {
    display: block;
    margin-block-start: 2px;
    font: 400 14px/20px var(--font-sans);
  }

  .work-history__meta {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }

  .work-history__as {
    margin-inline-end: 4px;
    font: 600 18px/1 var(--font-hand);
  }

  .work-history__employment {
    margin-inline-start: 6px;
    color: var(--muted);
    font: 400 12px/1.5 var(--font-mono);
  }

  .work-history__employment::before {
    content: "· ";
  }

  .work-history__dates {
    margin-block-start: 2px;
    color: var(--muted);
    font: 400 12px/1.5 var(--font-mono);
    white-space: nowrap;
  }

  .work-history__chevron {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border: 1px solid var(--technical-line-strong);
    border-radius: 6px;
  }

  .work-history__toggle:hover .work-history__chevron {
    border-color: var(--foreground);
  }

  .work-history__bullets {
    margin: 16px 0 0;
    padding-inline-start: 20px;
    color: var(--muted);
    font: 400 14px/22px var(--font-sans);
  }

  .work-history__bullets li + li {
    margin-block-start: 2px;
  }

  .work-history__stack {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    min-height: 24px;
    margin: 16px 0 0;
    padding: 0 0 0 12px;
    list-style: none;
  }

  .work-history__stack::before {
    position: absolute;
    inset-inline-start: -5px;
    inset-block-end: 7.5px;
    width: 9px;
    height: 9px;
    border: 1px solid var(--technical-line-strong);
    border-radius: 50%;
    background: var(--surface);
    content: "";
  }

  .work-history__stack li {
    padding: 2px 8px;
    border: 1px solid var(--technical-line-soft);
    border-radius: 999px;
    background: var(--surface-raised);
    color: var(--foreground);
    font: 400 12px/18px var(--font-mono);
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .work-history__entry {
      --work-history-mark-size: 32px;
      --work-history-mark-gap: 16px;
      padding-block: 24px;
    }

    .work-history__toggle {
      position: relative;
      flex-direction: column;
      gap: 6px;
    }

    .work-history__company {
      padding-inline-end: 32px;
    }

    .work-history__meta {
      align-items: flex-start;
    }

    .work-history__chevron {
      position: absolute;
      inset-block-start: 2px;
      inset-inline-end: 0;
    }

    .work-history__employment {
      display: block;
      margin: 2px 0 0;
    }

    .work-history__employment::before {
      content: none;
    }
  }
</style>
