---
import { Image } from "astro:assets";
import { getCollection, type CollectionEntry } from "astro:content";
import MorphIcon from "morphicons/astro";
import { ArrowRight } from "lucide";
import { BLOG_CATEGORY_LABELS, formatBlogDate, getBlogReadingMinutes } from "../data/blog";
import SectionLabel from "./SectionLabel.astro";
import UnderlineMark from "./UnderlineMark.astro";

type BlogPost = CollectionEntry<"blog">;

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const primaryPost = posts.find(({ data }) => data.featured) ?? posts[0];
const supportingPosts = primaryPost
  ? posts.filter(({ id }) => id !== primaryPost.id).slice(0, 3)
  : [];

const getCategory = ({ data }: BlogPost) => BLOG_CATEGORY_LABELS[data.category];
---

{
  primaryPost && (
    <section class="featured-blogs" aria-labelledby="featured-blogs-title">
      <SectionLabel id="featured-blogs-title" title="Featured Blogs" />

      <div class="featured-blogs__frame">
        <span class="featured-blogs__choice" aria-hidden="true">
          <span>dharma&apos;s choice</span>
          <svg viewBox="0 0 150 60" fill="none">
            <path
              d="M76 7C75 27 89 38 108 39C116 39 123 37 128 35"
              vector-effect="non-scaling-stroke"
            />
            <path
              d="M116 28L128 35L119 46"
              vector-effect="non-scaling-stroke"
            />
          </svg>
        </span>

        <article class="featured-blogs__primary">
          <a class="featured-blogs__primary-link" href={`/blog/${primaryPost.id}/`}>
            <span class="featured-blogs__primary-copy">
              <span class="featured-blogs__title">
                <h3>{primaryPost.data.title}</h3>
                <UnderlineMark class="featured-blogs__title-mark" />
              </span>
              <p>{primaryPost.data.description}</p>
            </span>

            <span class:list={["featured-blogs__primary-meta", { "featured-blogs__primary-meta--no-reading-time": !primaryPost.body?.trim() }]}>
              <time datetime={primaryPost.data.publishedAt.toISOString()}>
                {formatBlogDate(primaryPost.data.publishedAt)}
              </time>
              {primaryPost.body?.trim() && <span>{getBlogReadingMinutes(primaryPost.body)} min read</span>}
              <span>{getCategory(primaryPost)}</span>
            </span>

            <span class="featured-blogs__cover">
              {primaryPost.data.cover ? (
                <Image
                  src={primaryPost.data.cover}
                  alt={`Cover for ${primaryPost.data.title}`}
                  width={Math.min(primaryPost.data.cover.width, 704)}
                  widths={[320, 480, 640, 960, 1280]}
                  sizes="auto, (min-width: 769px) 50vw, 100vw"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="featured-blogs__cover-empty" aria-hidden="true" />
              )}
            </span>
          </a>
        </article>

        <div class="featured-blogs__supporting">
          <ol class:list={["featured-blogs__list", { "featured-blogs__list--with-coming-soon": supportingPosts.length < 3 }]}>
            {supportingPosts.map((post) => (
              <li>
                <article>
                  <a class="featured-blogs__item" href={`/blog/${post.id}/`}>
                    <span class="featured-blogs__item-topline">
                      <span>{getCategory(post)}</span>
                      <MorphIcon icon={ArrowRight} size={22} strokeWidth={1.25} aria-hidden="true" />
                    </span>

                    <span class="featured-blogs__item-copy">
                      <span class="featured-blogs__title">
                        <h3>{post.data.title}</h3>
                        <UnderlineMark class="featured-blogs__title-mark" />
                      </span>
                      <p>{post.data.description}</p>
                    </span>

                    <span class="featured-blogs__item-meta">
                      <time datetime={post.data.publishedAt.toISOString()}>
                        {formatBlogDate(post.data.publishedAt)}
                      </time>
                      {post.body?.trim() && <span>{getBlogReadingMinutes(post.body)} min read</span>}
                    </span>
                  </a>
                </article>
              </li>
            ))}
          </ol>
          {supportingPosts.length < 3 && (
            <div class="featured-blogs__coming-soon">
              <div class="featured-blogs__riffle"></div>
              <p>more writing coming soon.</p>
            </div>
          )}
        </div>
      </div>
    </section>
  )
}

<script>
  import { riffle } from "@lucasmarkes/hairline";

  const stage = document.querySelector<HTMLElement>(".featured-blogs__riffle");

  if (stage) {
    const laptop = window.matchMedia("(min-width: 1025px)");
    let figure: ReturnType<typeof riffle> | undefined;

    const syncFigure = () => {
      if (laptop.matches && !figure) {
        figure = riffle(stage, { intensity: 0.45 });
      } else if (!laptop.matches && figure) {
        figure.destroy();
        figure = undefined;
      }
    };

    syncFigure();
    laptop.addEventListener("change", syncFigure);
  }
</script>
