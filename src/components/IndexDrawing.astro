---
interface Props {
  variant: "project" | "blogs" | "statistics";
}

const { variant } = Astro.props;
---

<svg
  class="index-drawing"
  viewBox="0 74.555 1153 800"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <defs>
    <pattern id={`${variant}-grid`} width="54.638" height="53.624" patternUnits="userSpaceOnUse" patternTransform="translate(59.311 74.555)">
      <path d="M0 0V53.624M0 0H54.638" stroke="currentColor" stroke-width="1.1" opacity=".2" />
      <path d="M27.319 0V53.624M0 26.812H54.638" stroke="currentColor" stroke-width="1.55" stroke-dasharray="3.17 3.17" opacity=".2" />
    </pattern>
  </defs>

  <rect class="index-drawing__grid" x="0" y="74.555" width="1153" height="723.96" fill={`url(#${variant}-grid)`} />

  <g stroke="currentColor" stroke-width=".8" opacity=".42">
    {variant === "statistics" ? (
      <Fragment>
        <path d="M72 330H658M364 106V378" stroke-dasharray="12 10" />
        <path d="M90 330C170 330 202 318 236 275C278 222 290 132 364 132C438 132 450 222 492 275C526 318 558 330 638 330" />
        <path d="M256 330V252M472 330V252M148 330V314M580 330V314" stroke-dasharray="5 7" />
        <path d="M256 106H472M256 98V114M472 98V114" />
        <path d="M262 102L256 106L262 110M466 102L472 106L466 110" />
        <path d="M256 344V354M364 344V354M472 344V354" />
        <path d="M742 118V330H1072" />
        <path d="M742 158H1072M742 244H1072" stroke-dasharray="5 7" />
        <path d="M770 298L1046 138" />
        <path d="M825 266H1014V156" stroke-dasharray="12 10" />
        <path d="M857 266A32 32 0 0 0 853 250" />
        <circle cx="790" cy="280" r="5" />
        <circle cx="842" cy="255" r="5" />
        <circle cx="890" cy="234" r="5" />
        <circle cx="938" cy="186" r="5" />
        <circle cx="990" cy="184" r="5" />
        <circle cx="1032" cy="148" r="5" />
        <path d="M748 124L742 118L736 124M1066 324L1072 330L1066 336" />
      </Fragment>
    ) : variant === "blogs" ? (
      <Fragment>
        <path d="M45 148H1110M45 349H1110" stroke-dasharray="12 10" />
        <path d="M550 112V433" stroke-dasharray="12 10" />
        <path d="M72 106H409M72 98V114M409 98V114" />
        <path d="M76 102L72 106L76 110M405 102L409 106L405 110" />
        <circle cx="224" cy="259" r="88" />
        <path d="M550 258m-108 0a108 108 0 1 0 216 0a108 108 0 1 0-216 0" />
        <path d="M550 258H658M550 258L604 164.5" />
        <path d="M591 187a82 82 0 0 1 41 71M587 188L591 187L592 192M627 254L632 258L636 254" />
        <path d="M884 258a109 109 0 0 1 218 0M884 258H1102" stroke-dasharray="12 10" />
      </Fragment>
    ) : (
      <Fragment>
        <path d="M1150.8 74L995.5 205.7" stroke-dasharray="19 19" />
        <path d="M306 132V432M629.3 148V494" stroke-dasharray="19 19" />
        <path d="M865.2 75.1H594M271.2 256.2H0M833.8 256H270" stroke-dasharray="19 19" />
        <path d="M266 420.8L392.6 152" stroke-dasharray="19 19" />
        <path d="M83.3 362.9L87.4 354.3" />
        <path d="M136.3 121.9V393.1" stroke-dasharray="19 19" />
        <path d="M730.4 355.6H557" />
        <path d="M1051.3 255.7a113 113 0 1 1-115.5-114.5" />
        <path d="M76.8 355.3a114 114 0 1 1 157.6-40.2" />
        <circle cx="135.6" cy="257.3" r="61.6" stroke-width=".4" />
        <path d="M643.7 281.7a64 64 0 0 1 63.4 62.6" />
        <path d="M596.7 71.9L593.2 75.1l3.5 3.3M268.6 253l3.5 3.2-3.5 3.3M933.2 138.6l3.4 2.6-3.4 3.3M133 124.5l3.2-3.5 3.3 3.5M232.9 311.1l1.1 4.7 4.5-1.5M703.7 341.8l3.4 3.4 3.1-3.7" />
      </Fragment>
    )}
  </g>

  <g fill="currentColor" opacity=".55" font-family="Geist Mono Variable, monospace" font-size="13" font-weight="400">
    {variant === "statistics" ? (
      <Fragment>
        <text x="347" y="94">2σ</text>
        <text x="354" y="370">μ</text>
        <text x="866" y="256">30°</text>
      </Fragment>
    ) : variant === "blogs" ? (
      <Fragment>
        <text x="246" y="97">337</text>
        <text x="598" y="237">60°</text>
        <text x="1002" y="185">180°</text>
      </Fragment>
    ) : (
      <Fragment>
        <text x="314" y="344">135°</text>
        <text x="946" y="326">270°</text>
        <text x="648" y="347">90°</text>
      </Fragment>
    )}
  </g>
</svg>

<style>
  .index-drawing {
    display: block;
    width: 100%;
    height: auto;
    color: var(--technical-line-strong);
  }

  .index-drawing__grid {
    opacity: .55;
  }

</style>
