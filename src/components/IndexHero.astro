---
import HeaderBackdrop from "./HeaderBackdrop.astro";

interface Props {
  variant: "project" | "blogs" | "statistics";
}

const { variant } = Astro.props;
---

<HeaderBackdrop variant={variant} />

<style>
  :global(.index-hero) {
    --index-artwork-height: clamp(240px, 45vw, 450px);
    --header-backdrop-height: var(--index-artwork-height);
    --header-backdrop-drawing-top: var(--header-height);
    position: relative;
    isolation: isolate;
    min-height: var(--index-artwork-height);
    padding-top: var(--header-height);
  }

  :global(.index-hero .content-page__header) {
    position: absolute;
    z-index: 1;
    top: clamp(140px, 20vw, 226px);
    left: 40px;
    width: min(660px, calc(100% - 80px));
  }

  :global(.index-hero .content-page__header h1) {
    color: var(--foreground);
    font: 500 clamp(5rem, 14vw, 9.5rem)/0.78 var(--font-hand);
    letter-spacing: -0.035em;
    text-transform: none;
  }

  @media (max-width: 575px) {
    :global(.index-hero .content-page__header) {
      top: calc(var(--header-height) + 40px);
      left: 20px;
      width: calc(100% - 40px);
    }
  }
</style>
