---
import { Search } from "lucide";
import MorphIcon from "morphicons/astro";

interface Props {
  collection: "projects" | "blog";
  variant?: "standalone" | "inline";
  placeholder?: string;
}

const { collection, variant = "standalone", placeholder } = Astro.props;
const isBlog = collection === "blog";
const searchLabel = isBlog ? "Search blogs" : "Search projects";
const inputId = `${isBlog ? "blog" : "project"}-search-input`;
---

<section class:list={["index-search", { "index-search--inline": variant === "inline" }]} aria-label={searchLabel} data-index-search-toolbar data-search-collection={collection}>
  <form class="index-search__frame" role="search" aria-label={searchLabel}>
    <div class="index-search__field">
      <span class="index-search__icon" aria-hidden="true">
        <MorphIcon icon={Search} size={16} strokeWidth={1.5} data-index-search-icon />
      </span>
      <label class="visually-hidden" for={inputId}>{searchLabel}</label>
      <input
        id={inputId}
        type="search"
        name="query"
        placeholder={placeholder ?? (isBlog ? "Search topics, categories, tags..." : "Search projects, stack, platform...")}
        autocomplete="off"
        data-index-search-input
      />
    </div>
  </form>
  <span class="visually-hidden" role="status" aria-atomic="true" data-index-search-status></span>
  <script src="../scripts/index-search.ts"></script>
</section>

<style>
  .index-search {
    position: relative;
    z-index: 2;
    border-bottom: 1px solid var(--technical-line-soft);
  }

  .index-search__frame {
    width: min(var(--content-max-width), calc(100% - var(--page-gutter) - var(--page-gutter)));
    margin-inline: auto;
    padding: 12px 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .index-search--inline {
    flex: 0 1 280px;
    min-width: 0;
    border-block-end: 0;
  }

  .index-search--inline .index-search__frame {
    width: 100%;
    padding: 0;
  }

  .index-search__field {
    flex: 0 1 360px;
    min-width: 0;
    margin-inline-start: auto;
    display: flex;
    align-items: center;
    gap: 10px;
    padding-inline: 14px;
    border: 1px solid var(--technical-line-soft);
    background: transparent;
    color: var(--muted);
  }

  .index-search__field:focus-within {
    border-color: var(--muted);
    box-shadow: 0 0 0 1px var(--muted);
  }

  .index-search__field input {
    width: 100%;
    min-width: 0;
    height: 38px;
    padding: 0;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--foreground);
    font: 400 11px/1 var(--font-mono);
    letter-spacing: 0.04em;
  }

  .index-search__field input::placeholder {
    color: var(--muted);
    font: 400 10px/1 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 1;
  }

  .index-search__icon {
    display: inline-flex;
    flex-shrink: 0;
  }

  .index-search[aria-busy="true"] .index-search__icon {
    animation: index-search-spin 800ms linear infinite;
  }

  @keyframes index-search-spin {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 768px) {
    .index-search__field input {
      height: 44px;
      font-size: 16px;
    }
  }

  @media (max-width: 640px) {
    .index-search--inline {
      flex-basis: 100%;
    }

    .index-search__frame {
      padding-inline: 0;
    }

    .index-search__field {
      flex-basis: 100%;
      padding-inline: 12px;
    }

    .index-search__field input::placeholder {
      font-size: clamp(10px, 3.125vw, 12px);
    }
  }
</style>
