---
import { getCollection, type CollectionEntry } from "astro:content";
import { ChevronDown, Filter, Search, X } from "lucide";
import MorphIcon from "morphicons/astro";
import { BLOG_CATEGORIES, BLOG_TAGS } from "../data/blog";
import { STACKS } from "../data/stacks";

interface Props {
  collection: "projects" | "blog";
}

interface FilterGroup {
  name: "projectType" | "platform" | "stack" | "category" | "tags";
  label: string;
  options: { value: string; label: string }[];
}

const { collection } = Astro.props;
const isBlog = collection === "blog";
const searchLabel = isBlog ? "Search blogs" : "Search projects";
let groups: FilterGroup[];

if (isBlog) {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  const tags = BLOG_TAGS.filter(({ id }) => posts.some(({ data }) => data.tags.includes(id)));
  groups = [
    { name: "category", label: "Category", options: BLOG_CATEGORIES.map(({ id, label }) => ({ value: id, label })) },
    { name: "tags", label: "Tags", options: tags.map(({ id, label }) => ({ value: id, label })) },
  ];
} else {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  const projectTypes = {
    "full-time": "Full-time",
    freelance: "Freelance",
    "self-built": "Self-built product",
    experiment: "Experiments & learning",
  } satisfies Record<CollectionEntry<"projects">["data"]["projectType"], string>;
  const platforms = [...new Set(projects.flatMap(({ data }) => data.platform.split(" · ")))].sort();
  const stacks = STACKS.filter(({ id }) => projects.some(({ data }) => data.stack.includes(id)));
  groups = [
    { name: "projectType", label: "Project type", options: Object.entries(projectTypes).map(([value, label]) => ({ value, label })) },
    { name: "platform", label: "Platform", options: platforms.map((platform) => ({ value: platform, label: platform })) },
    { name: "stack", label: "Stack", options: stacks.map(({ id, label }) => ({ value: id, label })) },
  ];
}
---

<section class="index-search" aria-label={isBlog ? "Blog search and filters" : "Project search and filters"} data-index-search-toolbar data-search-collection={collection} data-filter-count="0" aria-busy="false">
  <form class="index-search__frame" role="search" aria-label={searchLabel}>
    <div class="index-search__filters">
      <span class="index-search__note" aria-hidden="true">Filter by:</span>
      <details class="index-search__dropdown" data-index-filter-popup>
        <summary aria-label="Select filters">
          <MorphIcon icon={Filter} size={14} strokeWidth={1.5} aria-hidden="true" />
          <span>Filters</span>
          <span class="index-search__badge" data-index-filter-badge aria-hidden="true" hidden>0</span>
          <MorphIcon icon={ChevronDown} size={12} strokeWidth={1.5} data-index-filter-chevron aria-hidden="true" />
        </summary>
        <div class="index-search__menu">
          <div class="index-search__groups">
            {groups.map((group) => (
              <fieldset class="index-search__group">
                <legend>{group.label}</legend>
                <div class="index-search__selection">
                  <details class="index-search__select" name={`${collection}-filter-groups`} data-index-search-dropdown={group.name} data-filter-label={group.label} data-filter-count="0">
                    <summary aria-label={`Select ${group.label}`} aria-controls={`${collection}-filter-${group.name}`}>
                      <span class="index-search__placeholder" data-index-filter-placeholder>Select {group.label.toLowerCase()}</span>
                      <span class="index-search__chips" data-index-filter-chips aria-hidden="true" hidden></span>
                      <span class="index-search__group-chevron" aria-hidden="true">
                        <MorphIcon icon={ChevronDown} size={12} strokeWidth={1.5} data-index-group-chevron />
                      </span>
                    </summary>
                    <div class="index-search__options" id={`${collection}-filter-${group.name}`}>
                      {group.options.map(({ value, label }) => (
                        <label class="index-search__option">
                          <input type="checkbox" name={group.name} value={value} data-index-filter />
                          <span>{label}</span>
                        </label>
                      ))}
                    </div>
                  </details>
                  <button class="index-search__group-clear" type="button" data-index-group-clear aria-label={`Clear ${group.label}`} hidden>
                    <MorphIcon icon={X} size={14} strokeWidth={1.5} aria-hidden="true" />
                  </button>
                </div>
              </fieldset>
            ))}
          </div>
          <div class="index-search__footer">
            <span>Active filters: <output data-index-filter-count aria-live="polite">0</output></span>
            <button class="index-search__clear" type="button" data-index-filter-clear disabled>Clear all filters</button>
          </div>
        </div>
      </details>
    </div>

    <div class="index-search__field">
      <span class="index-search__icon" aria-hidden="true">
        <MorphIcon icon={Search} size={16} strokeWidth={1.5} data-index-search-icon />
      </span>
      <label class="visually-hidden" for={`${isBlog ? "blog" : "project"}-search-input`}>{searchLabel}</label>
      <input
        id={`${isBlog ? "blog" : "project"}-search-input`}
        type="search"
        name="query"
        placeholder="SEARCH KEYWORD"
        autocomplete="off"
        data-index-search-input
      />
    </div>
  </form>
  <span class="visually-hidden" role="status" data-index-search-status></span>
  <script src="../scripts/index-search.ts"></script>
</section>

<style>
  .index-search {
    position: relative;
    z-index: 2;
    border-bottom: 1px solid var(--technical-line-soft);
  }

  .index-search__frame {
    width: min(var(--content-max-width), calc(100% - var(--page-gutter) - var(--page-gutter)));
    margin-inline: auto;
    padding: 12px 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .index-search__field {
    flex: 0 1 250px;
    min-width: 0;
    margin-inline-start: auto;
    display: flex;
    align-items: center;
    gap: 10px;
    padding-inline: 14px;
    border: 1px solid var(--technical-line-soft);
    background: transparent;
    color: var(--muted);
  }

  .index-search__field:focus-within {
    border-color: var(--muted);
    box-shadow: 0 0 0 1px var(--muted);
  }

  .index-search__field input {
    width: 100%;
    min-width: 0;
    height: 38px;
    padding: 0;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--foreground);
    font: 400 11px/1 var(--font-mono);
    letter-spacing: 0.04em;
  }

  .index-search__field input::placeholder,
  .index-search__dropdown > summary {
    font: 400 10px/1 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .index-search__field input::placeholder {
    color: var(--muted);
    opacity: 1;
  }

  .index-search__icon {
    display: inline-flex;
    flex-shrink: 0;
  }

  .index-search[aria-busy="true"] .index-search__icon {
    animation: index-search-spin 800ms linear infinite;
  }

  .index-search__filters {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .index-search__note {
    white-space: nowrap;
    color: var(--muted);
    font: 500 10px/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .index-search__dropdown > summary {
    min-height: 36px;
    padding-inline: 11px;
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--technical-line-soft);
    background: transparent;
    color: var(--muted);
    list-style: none;
    cursor: pointer;
    white-space: nowrap;
  }

  .index-search__dropdown {
    position: relative;
  }

  .index-search__dropdown > summary::-webkit-details-marker,
  .index-search__select > summary::-webkit-details-marker {
    display: none;
  }

  .index-search__dropdown > summary:hover {
    border-color: var(--technical-line-strong);
    color: var(--foreground);
  }

  .index-search__dropdown[open] > summary,
  .index-search:not([data-filter-count="0"]) .index-search__dropdown > summary {
    border-color: var(--foreground);
    background: var(--foreground);
    color: var(--surface);
  }

  .index-search__badge {
    min-width: 18px;
    height: 18px;
    padding-inline: 4px;
    display: inline-grid;
    place-items: center;
    border-radius: 50%;
    background: color-mix(in srgb, var(--surface) 18%, transparent);
    color: inherit;
    font-size: 9px;
    letter-spacing: 0;
  }

  .index-search__dropdown > summary:focus-visible,
  .index-search__select > summary:focus-visible,
  .index-search__group-clear:focus-visible,
  .index-search__option input:focus-visible,
  .index-search__clear:focus-visible {
    outline: 2px solid var(--muted);
    outline-offset: 2px;
  }

  .index-search__menu {
    position: absolute;
    z-index: 1;
    inset: calc(100% + 8px) auto auto var(--index-search-menu-offset, 0px);
    width: min(440px, calc(100vw - var(--page-gutter) - var(--page-gutter) - 32px));
    max-height: min(640px, var(--index-search-menu-height, calc(100dvh - 32px)));
    padding: 20px;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--technical-line-soft);
    background: var(--surface-raised);
  }

  .index-search__menu[data-placement="above"] {
    inset-block-start: auto;
    inset-block-end: calc(100% + 8px);
  }

  .index-search__group {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .index-search__groups {
    min-height: 0;
    margin: -4px;
    padding: 4px;
    display: grid;
    align-content: start;
    gap: 20px;
    overflow-y: auto;
  }

  .index-search__group legend {
    margin-bottom: 8px;
    padding: 0;
    color: var(--foreground);
    font: 500 0.6875rem/1.4 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .index-search__selection {
    position: relative;
  }

  .index-search__select > summary {
    min-height: 44px;
    padding: 8px 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--technical-line-soft);
    color: var(--muted);
    font: 400 11px/1.4 var(--font-mono);
    list-style: none;
    cursor: pointer;
  }

  .index-search__select > summary:hover,
  .index-search__select[open] > summary {
    border-color: var(--technical-line-strong);
    color: var(--foreground);
  }

  .index-search__select:not([data-filter-count="0"]) > summary {
    padding-inline-end: 48px;
  }

  .index-search__group-chevron {
    display: inline-flex;
    margin-inline-start: auto;
    flex-shrink: 0;
  }

  .index-search__placeholder {
    min-width: 0;
    text-transform: uppercase;
  }

  .index-search__chips {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  :global(.index-search__chip) {
    min-width: 0;
    padding: 4px 6px;
    border: 1px solid var(--technical-line-soft);
    background: var(--surface);
    color: var(--foreground);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.index-search__chip--more) {
    flex-shrink: 0;
  }

  .index-search__group-clear {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  .index-search__group-clear:hover {
    color: var(--foreground);
  }

  .index-search__options {
    max-height: 200px;
    margin-top: 8px;
    padding: 8px 12px;
    border: 1px solid var(--technical-line-soft);
    overflow-y: auto;
  }

  .index-search__option {
    min-height: 40px;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font: 400 0.75rem/1.5 var(--font-mono);
    overflow-wrap: anywhere;
    cursor: pointer;
  }

  .index-search__option:has(:checked),
  .index-search__option:hover {
    color: var(--foreground);
  }

  .index-search__option input {
    appearance: none;
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    margin: 0;
    display: grid;
    place-items: center;
    border: 1px solid var(--technical-line);
    background: transparent;
    color: var(--surface);
    cursor: pointer;
  }

  .index-search__option input:checked {
    border-color: var(--foreground);
    background: var(--foreground);
  }

  .index-search__option input:checked::after {
    content: "";
    width: 3px;
    height: 6px;
    margin-top: -2px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
  }

  .index-search__clear {
    min-height: 36px;
    padding: 8px;
    border: 0;
    background: transparent;
    color: var(--muted);
    font: 400 0.625rem/1.4 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .index-search__clear:hover {
    color: var(--foreground);
  }

  .index-search__clear:disabled {
    color: var(--technical-copy);
    cursor: default;
  }

  .index-search__footer {
    margin-top: 20px;
    padding-top: 12px;
    display: flex;
    flex-wrap: wrap;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    gap: 4px 12px;
    border-top: 1px solid var(--technical-line-soft);
    color: var(--muted);
    font: 400 0.625rem/1.4 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @keyframes index-search-spin {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 640px) {
    .index-search__field {
      flex-basis: 100%;
    }

    .index-search__filters {
      width: 100%;
      justify-content: space-between;
    }

    .index-search__menu {
      padding: 16px;
    }

    .index-search__field input {
      height: 42px;
      font-size: 12px;
    }

    .index-search__field input::placeholder,
    .index-search__dropdown > summary {
      font-size: 12px;
    }

    .index-search__dropdown > summary,
    .index-search__option,
    .index-search__clear {
      min-height: 44px;
    }
  }
</style>
