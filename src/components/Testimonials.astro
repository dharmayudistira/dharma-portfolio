---
import { testimonials } from "../data/testimonials";
import SectionLabel from "./SectionLabel.astro";

const visibleTestimonials = testimonials.slice(0, 3);
---

<section class="testimonials" aria-labelledby="testimonials-title" data-testimonials>
  <SectionLabel id="testimonials-title" title="Testimonials" />

  <div class="testimonials__cards">
    <div class="testimonials__frame">
      <ol class="testimonials__list" id="testimonial-cards">
        {
          visibleTestimonials.map((testimonial, index) => (
            <li data-testimonial-card data-testimonial-index={index}>
              <article class="testimonial-card">
                <blockquote class="testimonial-card__quote">
                  <span class="testimonial-card__quote-mark" aria-hidden="true">
                    &ldquo;
                  </span>
                  <p data-testimonial-quote>{testimonial.quote}</p>
                </blockquote>

                <footer class="testimonial-card__footer">
                  <span class="testimonial-card__avatar" aria-hidden="true">
                    <span></span>
                  </span>
                  <cite class="testimonial-card__identity" data-testimonial-identity>
                    <span data-testimonial-name>{testimonial.name}</span>
                    <span data-testimonial-company>{testimonial.company}</span>
                  </cite>
                </footer>
              </article>
            </li>
          ))
        }
      </ol>
      <span class="testimonials__cross testimonials__cross--left" aria-hidden="true"></span>
      <span class="testimonials__cross testimonials__cross--right" aria-hidden="true"></span>
    </div>
  </div>

  <div class="testimonials__controls" data-testimonial-controls hidden>
    <div class="testimonials__pagination" role="group" aria-label="Testimonial pages">
      {
        testimonials.map((_, index) => (
          <button
            class="testimonials__page"
            type="button"
            aria-label={`Show testimonial page ${index + 1}`}
            aria-controls="testimonial-cards"
            aria-current={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
            data-testimonial-page
          >
            <span class="testimonials__dot" aria-hidden="true">
              <span class="testimonials__progress" data-testimonial-progress></span>
            </span>
          </button>
        ))
      }
    </div>
  </div>
  <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-testimonial-announcer></p>

  <script src="../scripts/testimonial-rotation.ts"></script>
</section>
