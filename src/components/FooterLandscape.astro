---
import landscape from "../assets/footer-landscape.svg?raw";
import kernel from "../vendor/hairline/kernel.js?raw";
---

<div class="footer-landscape" aria-hidden="true">
  <div class="footer-landscape__frame" data-hairline="device-table">
    <Fragment set:html={landscape} />
  </div>
</div>

<script is:inline set:html={kernel} />
<script>
  import { mountFooterLandscape } from "../scripts/footer-landscape";
  import type { HairlineKernel, Point } from "../vendor/hairline/types";

  declare const HL: HairlineKernel;
  const stage = document.querySelector<HTMLElement>(".footer-landscape__frame");
  const svg = stage?.querySelector("svg");

  if (stage && svg) {
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    const observer = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      observer.disconnect();
      const engine: HairlineKernel = {
        ...HL,
        register: (element, tick) => HL.register(element, (dt, now) => {
          HL.setReducedMotion(motion.matches);
          return tick(dt, now);
        }),
        // Hairline's pointer uses 400 × 320; the footer shows the panoramic slice.
        pointer: (element, handlers) => {
          const viewBox = svg.viewBox.baseVal;
          const point = ([x, y]: Point): Point => [x, viewBox.y + y * viewBox.height / 320];
          return HL.pointer(element, {
            move: (position) => handlers.move(point(position)),
            down: (position) => handlers.down?.(point(position)),
            leave: handlers.leave,
          });
        },
      };
      const read = { textContent: "rest" };
      const figure = mountFooterLandscape({ stage, svg, read }, motion.matches ? 0 : 8, engine);
      motion.addEventListener("change", () => figure.set(motion.matches ? 0 : 8));
    }, { rootMargin: "400px" });
    observer.observe(stage);
  }
</script>
