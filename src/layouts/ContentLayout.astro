---
import type { ComponentProps } from "astro/types";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  showDescription?: boolean;
  pageClass?: string;
  jsonLd?: ComponentProps<typeof BaseLayout>["jsonLd"];
}

const {
  title,
  description,
  showDescription = true,
  pageClass,
  jsonLd,
} = Astro.props;
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <main>
    <div class:list={["content-page", pageClass]}>
      <header class="content-page__header">
        <h1>{title}</h1>
        {showDescription && <p class="content-page__description">{description}</p>}
      </header>
      <slot />
    </div>
    <slot name="after-content" />
  </main>
  <slot name="after-main" />
</BaseLayout>
