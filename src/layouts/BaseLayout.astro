---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "@fontsource-variable/caveat";
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

import AppBar from "../components/AppBar.astro";
import EntranceOverlay from "../components/EntranceOverlay.astro";
import PageGuides from "../components/PageGuides.astro";
import portfolioPreview from "../assets/social/portfolio-preview.png";
import { SITE_IDENTITY } from "../data/site";
import { GOATCOUNTER_URL } from "../data/analytics";

type JsonLd = Record<string, unknown>;

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  socialImagePosition?: "center" | "bottom";
  canonicalUrl?: string;
  ogType?: "website" | "article";
  publishedAt?: Date;
  updatedAt?: Date;
  jsonLd?: JsonLd | JsonLd[];
  noindex?: boolean;
}

const siteName = SITE_IDENTITY.name;
const {
  title = siteName,
  description = `${siteName}, product engineer working across frontend and mobile experiences.`,
  image,
  socialImagePosition = "center",
  canonicalUrl,
  ogType = "website",
  publishedAt,
  updatedAt,
  jsonLd,
  noindex = false,
} = Astro.props;

const pageTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonical = noindex
  ? undefined
  : canonicalUrl
    ? new URL(canonicalUrl)
    : Astro.site
      ? new URL(Astro.url.pathname, Astro.site)
      : undefined;
const socialImageAsset = await getImage({
  src: image ?? portfolioPreview,
  width: 1200,
  height: 630,
  fit: "cover",
  position: socialImagePosition,
  format: "jpeg",
  quality: 85,
});
const socialImage = Astro.site
  ? new URL(socialImageAsset.src, Astro.site)
  : undefined;
const socialImageAlt = image
  ? `Cover image for ${title}`
  : `${siteName} portfolio cover with a geometric drawing`;
const pathname = Astro.url.pathname;
const introMode = pathname === "/"
  ? "home"
  : pathname === "/projects/" || pathname === "/projects"
    ? "projects"
    : pathname === "/blog/" || pathname === "/blog"
      ? "blog"
      : pathname === "/statistics/" || pathname === "/statistics"
        ? "statistics"
        : "shell";
const serializedJsonLd = jsonLd
  ? JSON.stringify(jsonLd).replace(/</g, "\\u003c")
  : undefined;
const speedInsightsEnabled = import.meta.env.PROD
  && process.env.VERCEL_ENV === "production"
  && !noindex;
const goatCounterEnabled = import.meta.env.PROD
  && process.env.VERCEL_ENV === "production"
  && GOATCOUNTER_URL
  && !noindex;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="strict-origin" />
    <meta name="theme-color" content="#07090a" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="16x16 32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {!noindex && Astro.site && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title={`${siteName} | Blog & Projects`}
        href={new URL("/rss.xml", Astro.site)}
      />
    )}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:type" content="image/jpeg" />}
    {socialImage && <meta property="og:image:width" content="1200" />}
    {socialImage && <meta property="og:image:height" content="630" />}
    {socialImage && <meta property="og:image:alt" content={socialImageAlt} />}
    {ogType === "article" && publishedAt && (
      <meta property="article:published_time" content={publishedAt.toISOString()} />
    )}
    {ogType === "article" && updatedAt && (
      <meta property="article:modified_time" content={updatedAt.toISOString()} />
    )}

    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImage && <meta name="twitter:image:alt" content={socialImageAlt} />}

    <title>{pageTitle}</title>
    {serializedJsonLd && (
      <script type="application/ld+json" set:html={serializedJsonLd}></script>
    )}
    <noscript><style>.intro { display: none !important; }</style></noscript>

    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem("dharma:theme");
          const systemTheme = matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark";
          const theme = savedTheme === "light" || savedTheme === "dark"
            ? savedTheme
            : systemTheme;

          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;

          if (sessionStorage.getItem("dharma:intro-seen") === "1") {
            document.documentElement.dataset.intro = "seen";
          }
        } catch {
          document.documentElement.dataset.theme = "dark";
        }
      })();
    </script>
  </head>
  <body>
    <AppBar />
    <slot />
    <PageGuides />
    <EntranceOverlay mode={introMode} />
    {goatCounterEnabled && (
      <script
        is:inline
        async
        src="https://gc.zgo.at/count.js"
        data-goatcounter={`${GOATCOUNTER_URL}/count`}
        data-goatcounter-settings={JSON.stringify({ path: pathname })}
      ></script>
    )}
    {speedInsightsEnabled && (
      <>
        <script is:inline>
          window.si = window.si || function (...args) {
            (window.siq = window.siq || []).push(args);
          };
          window.si("beforeSend", (event) => {
            const url = new URL(event.url);
            url.search = "";
            url.hash = "";
            return { ...event, url: url.href };
          });
        </script>
        <script
          is:inline
          defer
          src="/_vercel/speed-insights/script.js"
          data-route={pathname}
        ></script>
      </>
    )}
  </body>
</html>
